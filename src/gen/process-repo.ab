#!/usr/bin/env amber

import { file_exists, dir_create, dir_exists, file_write, temp_dir_create } from "std/fs"
import { repo_json_value, repo_json_value_opt, repo_json_list } from "../shlib/json.ab"
import { hash_dir, hash_dir_or_default, hash_arr, read_state_hash, write_state } from "../shlib/hash.ab"
import { temp_file_create } from "../shlib/temp.ab"
import { log_genstep } from "log_genstep.ab"
import { J2 } from "../shlib/vendor.ab"
import { replace_one } from "std/text"
import { get_cache_dir } from "../shlib/cache.ab"

const CHANGE_MARK_DIR = temp_dir_create("jbdt-changes.XXXXXX", false) failed {
    "/tmp"
}

fun copy_repo(
    config_file: Text,
    gen_dir: Text,
    src_path: Text,
    target_path: Text,
    repo_id: Text,
    impl_choice: Text,
    cache_dir: Text,
    user_dir: Text
): Null? {
    const hooks_src = "{user_dir}/repo-hooks"
    const gen_hook = "{hooks_src}/generate_{repo_id}.ab"
    if file_exists(gen_hook) {
        $ SOURCE_PATH={src_path} TARGET_PATH={target_path} CACHE_PATH={cache_dir} REPO_ID={repo_id} GEN_DIR={gen_dir} HOOKS_DIR={hooks_src} CONFIG_FILE={config_file} J2_BIN={J2} amber {gen_hook} $ ?
        log_genstep("generated", target_path)
        return null
    }

    if not dir_exists(target_path) {
        dir_create(target_path)?
    }

    // Host-side test suites stay in the SOURCE repos (user/repos/...): they
    // never ship to the published bundle/installer.
    let rsync_excludes = [
        "--exclude", ".git/",
        "--exclude", "test_*.sh",
        "--exclude", "/test/",
    ]
    if impl_choice != "" {
        const variants = repo_json_list(config_file, repo_id, "impl_variants")?
        for variant in variants {
            if variant == "" or variant == impl_choice: continue
            rsync_excludes += ["--exclude", "/{variant}/"]
        }
    }

    // --delete-excluded: excluded patterns (tests, .git) are also REMOVED from
    // a previously generated target, not just skipped (plain --exclude would
    // protect them from --delete and stale files would survive regeneration).
    $ rsync -a --delete --delete-excluded {rsync_excludes} "{src_path}/" "{target_path}/" $ ?
    log_genstep("copied", target_path)
}

pub fun process_repo(config_file: Text, gen_dir: Text, repo_id: Text, dest_dir: Text, user_dir: Text, force_run: Bool): Null? {
    const cache_dir = get_cache_dir("jbdt-process-repo")?
    const state_dir = "{cache_dir}/generate_state"
    const repos_dir = "{user_dir}/repos"

    const src_path = "{repos_dir}/{repo_id}"

    const impl_choice = repo_json_value_opt(config_file, repo_id, "impl")
    const new_hash = hash_arr([hash_dir_or_default(src_path), impl_choice])?

    const rw_key = "repo__{repo_id}"
    const rw_filename = "{CHANGE_MARK_DIR}/{rw_key}"
    const old_hash = read_state_hash(state_dir, rw_key)

    const target = repo_json_value(config_file, repo_id, "target")?
    const target_path = "{dest_dir}/{target}"

    if force_run or new_hash != old_hash or not dir_exists(target_path) {
        copy_repo(config_file, gen_dir, src_path, target_path, repo_id, impl_choice, cache_dir, user_dir)?
        write_state(state_dir, rw_key, new_hash)?
        file_write(rw_filename, "{target}\n")?
    } else {
        log_genstep("cached", target_path)
    }
}

main(args) {
    process_repo(args[1], args[2], args[3], args[4], args[5], args[6] == "1")?
}
