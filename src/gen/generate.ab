#!/usr/bin/env amber

import { file_read, file_write, dir_create, dir_exists, temp_dir_create, file_exists } from "std/fs"
import { unique_match_file_glob_or_fail, file_ext, abspath, rm_force } from "../shlib/fs.ab"
import { echo_success, echo_error } from "std/env"
import { split_lines, parse_int, replace_regex, replace_one, split, join } from "std/text"
import { temp_file_create } from "../shlib/temp.ab"
import { GEN_DIR, GEN_SCRIPTS_DIR, SHLIB_DIR, RESOURCES_DIR, SCHEMA_FILE, DEST_DIR, INSTALLER_DIR, JSONNET_LIB_DIR } from "../vars.ab"
import { log_genstep } from "log_genstep.ab"
import { run_parallel } from "../shlib/parallel.ab"
import { get_filename_without_prefix } from "../shlib/regex.ab"
import { render_j2_template } from "render-job.ab"
import { compile_amber_job } from "compile-job.ab"
import { write_json_array } from "../shlib/json.ab"
import { json_value } from "json_config.ab"
import { JQ, JSONNET, JSONSCHEMA, LUA } from "../shlib/vendor.ab"
import { jsonnet_render_tla_file } from "../shlib/jsonnet.ab"
import { get_cache_dir } from "../shlib/cache.ab"
import { symlink_create_dir } from "../shlib/symlink.ab"
import { has_flag } from "../shlib/flag.ab"
import { time_ms } from "../shlib/time.ab"
import { audit_bundle, read_whitelist } from "audit.ab"
import { prune_tree } from "../shlib/fetch_prune.ab"

const MAX_JOBS = 8

// collect_flag_pairs: scan args for each occurrence of `flag` followed by a
// value token; return the list of values (supports multiple repeats).
fun collect_flag_pairs(args: [Text], flag: Text): [Text] {
    let values = []
    let i = 0
    while i < len(args) {
        if args[i] == flag and i + 1 < len(args) {
            values += [args[i + 1]]
            i += 2
        } else {
            i += 1
        }
    }
    return values
}

fun _render_jsonnet_into_filepath(jsonnet_path: Text, name: Text, tla_args: [Text]): Text? {
    const tmp_filepath = temp_file_create("-{name}.json")?
    $ {JSONNET} -J {JSONNET_LIB_DIR} {tla_args} {jsonnet_path} > {tmp_filepath} $ ?
    return tmp_filepath
}

fun render_jsonnet_into_filepath(jsonnet_path: Text, tla_args: [Text]): Text? {
    const config_file = _render_jsonnet_into_filepath(
        jsonnet_path, "jbtd-config-rendered", tla_args)?
    $ {JSONSCHEMA} validate {SCHEMA_FILE} {config_file} $ ?
    return config_file
}

fun render_jinja_tree(config_file: Text, tree_dir: Text, out_dir: Text): Null?  {
    let tasks = [] 
    const templates = split_lines($ find {tree_dir} -type f -name "*.j2" $ ?)
    for template in templates {
        tasks += ["{template} {tree_dir} {config_file} {out_dir}"]
    }
    run_parallel(tasks, MAX_JOBS, "{GEN_SCRIPTS_DIR}/render-job.ab")?
}

fun render_metadata(config_file: Text, out_json_path: Text): Null? {
    jsonnet_render_tla_file(
        "{GEN_SCRIPTS_DIR}/metadata.jsonnet",
        "source_jsonnet",
        config_file,
        "",
        out_json_path
    )?
    log_genstep("rendered", out_json_path)
}

// backfill_repo_hashes: read the per-repo content hash that process_repo.ab
// already wrote to the cache state dir for each enabled repo, and bake it
// into the bundle meta.json as a top-level repo_hashes map. The puller-side
// updater diffs this map against its persisted last-installed copy to decide
// which repos to re-install. Generated state is independent: cache state is
// local-only and never shipped.
//
// ponytail: build the JSON object as plain text and let jq slurpfile parse
// it. The braces in jq filter expressions trip amber command-literal parsing
// unless written as plain text.
fun backfill_repo_hashes(meta_json_path: Text, repo_ids: [Text], cache_dir: Text): Null? {
    const state_dir = "{cache_dir}/generate_state"
    let pairs_csv = ""
    let count = 0
    for repo_id in repo_ids {
        const state_file = "{state_dir}/repo__{repo_id}"
        if not file_exists(state_file) {
            continue
        }
        const h = $ sed -n '1p' "{state_file}" $ ?
        if h == "" { continue }
        if count > 0 { pairs_csv += "," }
        pairs_csv += "\"{repo_id}\":\"{h}\""
        count += 1
    }
    if count == 0 { return null }
    const frag = temp_file_create("repo-hashes-XXXXXX.json")?
    file_write(frag, "\{" + pairs_csv + "}")?
    // ponytail: static jq filter avoids amber brace-parsing in inline strings.
    $ {JQ} --slurpfile f "{frag}" -f "{RESOURCES_DIR}/merge-repo-hashes.jq" "{meta_json_path}" > "{meta_json_path}.tmp" $ ?
    mv("{meta_json_path}.tmp", "{meta_json_path}") failed { return null }
    rm_force("{frag}")?
    log_genstep("backfilled-repo-hashes", meta_json_path)
}


pub fun resolve_config_path(user_dir: Text, config_name: Text): Text? {
    if replace_one(config_name, "/", "") != config_name {
        return config_name
    }
    const jsonnet_path = "{user_dir}/config-presets/{config_name}.jsonnet"
    if file_exists(jsonnet_path) {
        return jsonnet_path
    }
    const json_path = "{user_dir}/config-presets/{config_name}.json"
    if file_exists(json_path) {
        return json_path
    }
    echo_error("Config preset not found: '{config_name}' in {user_dir}/config-presets/")
    fail 1
}

fun process_repos(dest_dir: Text, config_file: Text, force_run: Bool, user_dir: Text): [Text]? {
    const repo_ids = split_lines(
        $ {JQ} -r '.repositories[] | select(.enabled == true) | .id' {config_file} $ ?)

    let tasks = [] 
    for repo_id in repo_ids {
        tasks += ["{config_file} {GEN_DIR} {repo_id} {dest_dir} {user_dir} {force_run}"]
    }
    run_parallel(tasks, MAX_JOBS, "{GEN_SCRIPTS_DIR}/process-repo.ab")?
    return repo_ids
}

fun run_generate_post(hooks_src: Text, dest_dir: Text, config_file: Text): Null? {
    const post_hook = "{hooks_src}/generate_post.ab"
    if file_exists(post_hook) {
        $ SOURCE_IGNORED="" DEST_DIR={dest_dir} CONFIG_FILE={config_file} J2_BIN={JQ} amber {post_hook} $ ?
        log_genstep("post-generated", dest_dir)
    }
}

// Per-repo post-render hooks: run AFTER render_jinja_tree so each repo's tree
// is fully rendered (plain files, .j2 stripped). Mirrors generate_{repo}.ab but
// fires at the end of generation. Naming generate_{repo}_postrender.* colocates
// the hook next to generate_{repo}.* in the tree. A repo may ship either
// generate_{repo}_postrender.ab (full amber hook) OR just
// generate_{repo}_postrender.lua -- when only the .lua exists, copals runs it
// directly with LUA, no .ab proxy needed. The hook receives TARGET_PATH =
// {dest_dir}/{target}.
fun run_generate_postrender(hooks_src: Text, dest_dir: Text, config_file: Text, repo_ids: [Text]): Null? {
    // TODO: should also use parallel tasks for faster processing
    for repo_id in repo_ids {
        const ab_hook = "{hooks_src}/generate_{repo_id}_postrender.ab"
        const lua_hook = "{hooks_src}/generate_{repo_id}_postrender.lua"
        if file_exists(ab_hook) or file_exists(lua_hook) {
            const target = json_value(config_file, repo_id, "target")?
            const target_path = "{dest_dir}/{target}"
            if file_exists(ab_hook) {
                $ SOURCE_IGNORED="" DEST_DIR={dest_dir} CONFIG_FILE={config_file} REPO_ID={repo_id} TARGET_PATH={target_path} HOOKS_DIR={hooks_src} J2_BIN={JQ} amber {ab_hook} $ ?
            } else {
                $ DEST_DIR={dest_dir} CONFIG_FILE={config_file} REPO_ID={repo_id} TARGET_PATH={target_path} HOOKS_DIR={hooks_src} {LUA} {lua_hook} $ ?
            }
            log_genstep("postrendered", target_path)
        }
    }
}

fun build_installer(
    repo_ids: [Text],
    hooks_src: Text, out_dir: Text, 
    config_file: Text): Null? 
{
    const cleanup = true
    const hooks_dst_tmp = temp_dir_create("jbtd-install-build-XXXXXX", cleanup, cleanup)?
    let ids = []
    for id in repo_ids {
        const hook_glob = "{hooks_src}/install_{id}.ab*"
        const hook = unique_match_file_glob_or_fail(hook_glob) failed {
            const exit_code = status()
            if exit_code != 1 {
                echo("Failed glob {hook_glob}")
                fail 2
            } else {
                continue
            }
        }
        const ext = file_ext(hook)?
        ids += [id]
        cp(hook, "{hooks_dst_tmp}/{id}.{ext}")?
        log_genstep("placed", "{hooks_dst_tmp}/{id}.{ext}")
    }

    const ab_file = "install.ab"
    cp("{RESOURCES_DIR}/{ab_file}.j2", hooks_dst_tmp)?
    symlink_create_dir(SHLIB_DIR, "{hooks_dst_tmp}/shlib")?
    render_jinja_tree(config_file, hooks_dst_tmp, hooks_dst_tmp)?
    compile_amber_job(hooks_dst_tmp, "{hooks_dst_tmp}/{ab_file}", out_dir, false)?
}

fun generate(config_jsonnet: Text, dest_dir: Text, installer_dir: Text, force_run: Bool, user_dir: Text, tla_args: [Text], audit: Bool = false, prune: Bool = false): Null? {
    if force_run {
        if file_exists("{installer_dir}/meta.json") {
            rm_force(installer_dir)?
        }
    }
    dir_create(dest_dir)?
    dir_create(installer_dir)?
    const config_file = render_jsonnet_into_filepath(config_jsonnet, tla_args)?
    render_metadata(config_file, "{installer_dir}/meta.json")?
    const ids = process_repos(dest_dir, config_file, force_run, user_dir)?
    const cache_dir = get_cache_dir("jbdt-process-repo")?
    backfill_repo_hashes("{installer_dir}/meta.json", ids, cache_dir)?
    const hooks_src = "{user_dir}/repo-hooks"
    run_generate_post(hooks_src, dest_dir, config_file)?
    build_installer(ids, hooks_src, installer_dir, config_file)?; 
    render_jinja_tree(config_file, dest_dir, dest_dir)?
    run_generate_postrender(hooks_src, dest_dir, config_file, ids)?
    if prune {
        prune_tree(installer_dir, config_file)?
    }
    if audit {
        const whitelist = read_whitelist(config_file)
        audit_bundle(dest_dir, whitelist)?
    }
}

pub fun main_generate(args): Null? {
    const force_run = has_flag(args, "-f") or has_flag(args, "--force")
    const debug = has_flag(args, "-d") or has_flag(args, "--debug")
    const audit = has_flag(args, "--audit")
    const prune = has_flag(args, "--try-prune-fetch-and-urls")
    if debug {
        $ set -x $ ?
    }
    if len(args) < 2 {
        echo("generate: missing <user_dir> <config_name> [dest_root]")
        echo("  user_dir     path to user directory (e.g. 'user')")
        echo("  config_name  config preset name (e.g. 'config_personal')")
        echo("  flags        -f/--force, -d/--debug, --audit (hard-block opaque binaries/archives)")
        echo("               --try-prune-fetch-and-urls (replace URLs and neutralise fetch commands)")
        fail 1
    }
    const user_dir_input = abspath(args[0])?
    const config_name = args[1]
    const config_jsonnet = resolve_config_path(user_dir_input, config_name)?

    // Collect --tla <name=value> (jsonnet --tla-code) and --tla-str <name=value>
    // (jsonnet --tla-str) passthroughs for the config preset render.
    let tla_args = []
    for pair in collect_flag_pairs(args, "--tla") {
        tla_args += ["--tla-code", pair]
    }
    for pair in collect_flag_pairs(args, "--tla-str") {
        tla_args += ["--tla-str", pair]
    }

    const start_time = time_ms()?

    if len(args) > 2 {
        const dest_root = args[2]
        generate(config_jsonnet, "{dest_root}/src", dest_root, force_run, user_dir_input, tla_args, audit, prune)?
    } else {
        generate(config_jsonnet, DEST_DIR, INSTALLER_DIR, force_run, user_dir_input, tla_args, audit, prune)?
    }
    const elapsed = time_ms()? - start_time
    echo_success("Generation finished in {elapsed} ms")
}
