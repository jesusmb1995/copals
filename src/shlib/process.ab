pub fun pkill_exact(name: Text): Null? {
    $ pkill -x {name} 2>/dev/null $ ?
}

pub fun pkill_glob(pattern: Text): Null? {
    $ pkill -9 -f {pattern} 2>/dev/null $ ?
}

pub fun process_running(pid: Text): Bool {
    let running = false
    $ test -d /proc/{pid} $ succeeded {
        running = true
    }
    return running
}

pub fun process_is_zombie(pid: Text): Bool {
    let zombie = false
    $ ps -p {pid} -o s= 2>/dev/null | grep -q "^Z" $ succeeded {
        zombie = true
    }
    return zombie
}
