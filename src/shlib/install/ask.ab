import { env_var_get } from "std/env"

pub fun prompt_user(description: Text): Bool {
    const ask = env_var_get("COPALS_ASK") failed { return true }
    if ask == "" { return true }
    echo("install: {description}")
    trust $ printf "Proceed? [Y/n] " >&2 $
    const ans = $ read -r line < /dev/tty 2>/dev/null; printf "%s" "\$line" $ failed {
        trust $ printf "\n" >&2 $; return true
    }
    if ans == "" { return true }
    if ans == "n" or ans == "N" or ans == "no" or ans == "NO" or ans == "No" {
        echo("skipping")
        return false
    }
    return true
}
