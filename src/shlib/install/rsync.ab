import { echo_error } from "std/env"
import { dir_create } from "std/fs"
import { home } from "../env.ab"
import { rsync } from "../rsync.ab"
import { prompt_user } from "../install/ask.ab"

pub fun rsync_into_home(src: Text, rel_target: Text, delete: Bool = false): Null? {
    if not prompt_user("rsync {src} -> ~/{rel_target}") {
        return null
    }
    const excludes = []
    const h = home()?
    const target = "{h}/{rel_target}"
    dir_create(target)?
    rsync(src, target, excludes, delete)?
}

pub fun rsync_or_die_into_home(src: Text, rel_target: Text, delete: Bool = false) {
    rsync_into_home(src, rel_target, delete) failed {
        echo_error("rsync deploy of {src} into {rel_target} failed")
    }
}

pub fun rsync_or_die_opts(src: Text, target: Text, excludes: [Text], delete: Bool) {
    rsync(src, target, excludes, delete) failed {
        echo_error("rsync deploy of {src} into {target} failed")
    }
}

pub fun rsync_or_die_opts_into_home(src: Text, rel_target: Text, excludes: [Text], delete: Bool) {
    const h = home() failed {
        echo_error("rsync_or_die_opts_into_home: failed to resolve home directory")
        exit(1)
    }
    rsync_or_die_opts(src, "{h}/{rel_target}", excludes, delete)
}
