import { home } from "../env.ab"
import { dir_create } from "std/fs"
import { echo_error, echo_success } from "std/env"

pub fun cp_or_die(src: Text, dest: Text): Null {
    cp(src, dest) failed {
        echo_error("deploy of {src} into {dest} failed")
    }
}

pub fun copy_into_home(src: Text, rel_dest: Text): Text? {
    const home = home()?
    const dest = "{home}/{rel_dest}"
    dir_create(dest)?
    cp(src, dest, true)?
    return dest
}

pub fun copy_into_home_or_die(src: Text, rel_dest: Text): Text {
    const dest = copy_into_home(src, rel_dest) failed {
        echo_error("deploy of {rel_dest} into home failed")
    }
    return dest
}
