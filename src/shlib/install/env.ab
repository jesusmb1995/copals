import { echo_error } from "std/env"
import { env_var_get } from "std/env"

pub fun env_vars_get(var_names: [Text]): [Text]? {
    let var_values = []
    for name in var_names {
       var_values += [env_var_get(name)?] 
    }
    return var_values
}

pub fun env_vars_get_or_die(var_names: [Text]): [Text] {
    const var_values = env_vars_get(var_names) failed {
        echo_error("failed to get environment variables {var_names}")
    }
    return var_values
}
