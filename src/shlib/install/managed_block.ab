import { file_read, file_write, file_exists, dir_create } from "std/fs"
import { echo_error } from "std/env"
import { home } from "../env.ab"
import { dirname } from "../fs.ab"
import { prompt_user } from "../install/ask.ab"
import { temp_file_create } from "../temp.ab"

// Marker lines wrapping the bundle-managed block. Plain ASCII, no glob/regex
// metacharacters that matter for sed except a single '.' in "install.sh" (a
// harmless wildcard). The "___DEVTOOLS_AUTOGEN___" token scopes this
// installer's block; other tools' managed blocks (nvm/pyenv/pathman, ...) are
// untouched. Begin/end are the single source of truth — they are interpolated
// into HELPER below, so there is no duplicate literal to drift.
pub const MANAGED_BEGIN = "# BEGIN ___DEVTOOLS_AUTOGEN___ managed by install.sh - do not edit this block"
pub const MANAGED_END = "# END ___DEVTOOLS_AUTOGEN___"

// Verbatim, blank-line-preserving splice. Amber's split()/split_lines() drop
// empty segments, so a pure-amber line-array pass would strip blank lines from
// the user's rc file and from the shipped body. sed's range delete keeps every
// line outside BEGIN..END byte-for-byte; $(cat ...) normalizes trailing
// newlines so the separator before the block is stable across re-runs (no
// blank-line accumulation -> idempotent). Written to a temp file and run with
// bash (amber's $...$ command literal cannot host the helper's $/quotes).
const HELPER = "#!/usr/bin/env bash\nset -euo pipefail\nm1='{MANAGED_BEGIN}'\nm2='{MANAGED_END}'\nsrc=\"$1\"\ndest=\"$2\"\ntmp=\"$(mktemp)\"\nif [ -f \"$dest\" ]; then\n    sed \"/$m1/,/$m2/d\" \"$dest\" > \"$tmp\"\nfi\n: > \"$dest\"\nif [ -s \"$tmp\" ]; then\n    content=\"$(cat \"$tmp\")\"\n    if [ -n \"$content\" ]; then\n        printf '%s\\n\\n' \"$content\" >> \"$dest\"\n    fi\nfi\nprintf '%s\\n' \"$m1\" >> \"$dest\"\nprintf '%s\\n' \"$(cat \"$src\")\" >> \"$dest\"\nprintf '%s\\n' \"$m2\" >> \"$dest\"\nrm -f \"$tmp\"\n"

// Refresh the managed block in `dest` (absolute path) so it contains exactly the
// shipped `src` content, wrapped in MANAGED_BEGIN/MANAGED_END. Merge-safe and
// idempotent: user content outside the block is preserved verbatim; re-running
// replaces the block instead of duplicating it. If `dest` is absent it is
// created holding just the block. Reusable for any source/dest pair.
pub fun managed_block(src: Text, dest: Text): Null? {
    const parent = dirname(dest)?
    dir_create(parent)?
    const helper = temp_file_create("-managed_block.sh")?
    file_write(helper, HELPER)?
    $ bash {helper} {src} {dest} $ ?
    $ rm -f {helper} $ ?
}

pub fun managed_block_into_home(src: Text, rel_dest: Text): Null? {
    const h = home()?
    managed_block(src, "{h}/{rel_dest}")?
}

pub fun managed_block_or_die(src: Text, dest: Text) {
    if prompt_user("managed-block merge {src} -> {dest}") {
        managed_block(src, dest) failed {
            echo_error("managed-block merge of {src} into {dest} failed")
        }
    }
}

pub fun managed_block_or_die_into_home(src: Text, rel_dest: Text) {
    if prompt_user("managed-block merge {src} -> ~/{rel_dest}") {
        managed_block_into_home(src, rel_dest) failed {
            echo_error("managed-block merge of {src} into {rel_dest} failed")
        }
    }
}
