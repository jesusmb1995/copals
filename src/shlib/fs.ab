import { replace_regex } from "std/text"
import { file_glob } from "std/fs"
import { echo_error } from "std/env"
import { JQ } from "vendor.ab"

pub fun filename(path: Text): Text {
    return replace_regex(path, "^.*/", "")
}

pub fun dirname(path: Text): Text? {
    return $ dirname {path} $ ?
}

pub fun file_ext(path: Text): Text? {
    return $ echo "{path}" | cut -d. -f2- $ ?
}

pub fun unique_match_file_glob_or_fail(path_glob: Text): Text? {
    const matches = file_glob(path_glob)
    if len(matches) <= 0 { fail 1 }
    if len(matches) > 1 { fail 2 }
    return matches[0]
}

pub fun abspath(path: Text): Text? {
    return $ realpath {path} $ ?
}

pub fun realpath_or_empty(path: Text): Text {
    return trust $ realpath "{path}" 2>/dev/null || true $
}

pub fun rm_glob(pattern: Text, recursive: Bool = false): Null? {
    if recursive {
        $ rm -rf {pattern} $ ?
    } else {
        $ rm -f {pattern} $ ?
    }
}

pub fun rm_force(path: Text): Null? {
    $ rm -rf {path} $ ?
}

pub fun ensure_line_in_file(file: Text, line: Text): Null? {
    $ grep -qF "{line}" "{file}" 2>/dev/null $ failed {
        $ echo >> "{file}" $ ?
        $ echo "{line}" >> "{file}" $ ?
    }
}

pub fun rm_if_feature_not(config_file: Text, base_path: Text, feature: Text, expected: Text, rel_path: Text): Null? {
    const val = trust $ {JQ} -r '.features.{feature} // "{expected}"' {config_file} $
    if val != expected {
        rm_force("{base_path}/{rel_path}")?
    }
}

pub fun rm_if_feature_not_or_die(config_file: Text, base_path: Text, feature: Text, expected: Text, rel_path: Text) {
    rm_if_feature_not(config_file, base_path, feature, expected, rel_path) failed {
        echo_error("rm_if_feature_not: failed for feature {feature}")
    }
}

pub fun match_files(
    files: [Text],
    prefix: Text,
    suffix: Text,
    match: [Text] = []
): [Text] {
    let result = []
    if len(match) > 0 {
        for f in files {
            const base_name = filename(f)
            for m in match {
                if base_name == "{prefix}{m}{suffix}" {
                    result += [f]
                    break
                }
            }
        }
    } else {
        result = files
    }
    return result
}
