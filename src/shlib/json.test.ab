import { assert_eq } from "std/test"
import { to_json_array, json_value, json_value_or, json_has, repo_json_value, repo_json_value_opt, repo_json_list } from "json.ab"
import { temp_file_create } from "temp.ab"
import { file_write } from "std/fs"
import { join } from "std/text"
import { rm_force } from "fs.ab"
import { JQ } from "vendor.ab"

test "json: can generate correct json array" {
    const my_arr = ["a", "b", "cd"] 
    const expected = "\{\n  \"repos\": [\n    \"a\",\n    \"b\",\n    \"cd\"\n  ]\n}"
    const produced = to_json_array("repos", my_arr)?
    assert_eq(produced, expected)
}

test "json: can read json value from key" {
    const tmp = temp_file_create()?
    const json_content = "\{\"name\": \"test-value\"}"
    file_write(tmp, json_content)?
    const result = json_value(tmp, "name")?
    assert_eq(result, "test-value")
}

test "json: fails if file does not exist" {
    let has_failed = false
    json_value("unexisting.json", "name") failed {
        has_failed = true
    }
    const should_fail = true
    assert_eq(should_fail, has_failed)
}

test "json: fails if key does not exist" {
    const tmp = temp_file_create()?
    const json_content = "\{\"name\": \"test-value\"}"
    file_write(tmp, json_content)?

    let has_failed = false
    json_value(tmp, "other-name") failed {
        has_failed = true
    }

    const should_fail = true
    assert_eq(should_fail, has_failed)
}

test "json_value_or: returns value when key present" {
    const tmp = temp_file_create()?
    file_write(tmp, "\{\"name\": \"test-value\"}")?
    assert_eq(json_value_or(tmp, "name", "fallback")?, "test-value")
}

test "json_value_or: returns default when key missing" {
    const tmp = temp_file_create()?
    file_write(tmp, "\{\"name\": \"test-value\"}")?
    assert_eq(json_value_or(tmp, "absent", "fallback")?, "fallback")
}

test "json_has: returns true when jq filter matches" {
    const tmp = temp_file_create()?
    file_write(tmp, "\{\"x\": 1, \"y\": 2}")?
    assert_eq(json_has(tmp, ".x == 1")?, true)
}

test "json_has: returns false when jq filter does not match" {
    const tmp = temp_file_create()?
    file_write(tmp, "\{\"x\": 1, \"y\": 2}")?
    assert_eq(json_has(tmp, ".x == 2")?, false)
}

test "json_has: works with --arg variables" {
    const tmp = temp_file_create()?
    file_write(tmp, "\{\"name\": \"alice\"}")?
    // amber command literals cannot embed jq `$var` refs (the `$` closes the
    // literal), so the arg value is inlined into the filter instead of `--arg`.
    const result = $ {JQ} -r '.name == "alice"' {tmp} $ ?
    assert_eq(result, "true")
}

// --- repo-scoped lookups (moved from gen/json_config.test.ab; doc 02, change 3) ---
// Fixture mirrors the shape generate.ab consumes: a top-level "repositories"
// array where each row has an "id" and per-repo keys. Built line-by-line
// because amber treats a bare { as string interpolation (\{ escapes it).
fun build_repo_fixture(): Text {
    let fx_lines = []
    fx_lines += ["\{"]
    fx_lines += ["  \"repositories\": ["]
    fx_lines += ["    \{ \"id\": \"nvim\", \"target\": \".config/nvim\", \"tags\": [\"editor\", \"gui\"] },"]
    fx_lines += ["    \{ \"id\": \"zsh\",  \"target\": \".config/zsh\" }"]
    fx_lines += ["  ]"]
    fx_lines += ["}"]
    return join(fx_lines, "\n")
}

fun repo_fixture_path(): Text? {
    const p = "/tmp/amber_repo_json_test.json"
    file_write(p, build_repo_fixture())?
    return p
}

test "repo_json_value: reads a repo-scoped scalar" {
    const f = repo_fixture_path()?
    assert_eq(repo_json_value(f, "nvim", "target")?, ".config/nvim")
    rm_force(f)?
}

test "repo_json_value_opt: empty string when the repo lacks the key" {
    const f = repo_fixture_path()?
    assert_eq(repo_json_value_opt(f, "zsh", "tags"), "")
    rm_force(f)?
}

test "repo_json_list: returns array elements for a repo" {
    const f = repo_fixture_path()?
    assert_eq(repo_json_list(f, "nvim", "tags")?, ["editor", "gui"])
    rm_force(f)?
}
