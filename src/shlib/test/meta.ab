pub fun get_meta_bool(key: Text): Bool {
    const jq_out = trust $ jq -r '.{key} | if . == true or . == "true" then "true" else "false" end' /tests/meta.json 2>/dev/null $
    return jq_out == "true"
}

// Read a string meta.json field; "" when missing (caller trims if needed).
pub fun get_meta_str(key: Text): Text {
    return trust $ jq -r '.{key} // ""' /tests/meta.json 2>/dev/null || echo "" $
} // TODO move other etest scripts here to this folder
