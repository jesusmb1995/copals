import { dir_exists, file_exists } from "std/fs"
import { replace_regex } from "std/text"

// project_root() is the single canonical definition (doc 02). vars.ab and
// other modules call it instead of re-defining the same heuristic.
pub fun project_root(): Text {
    if file_exists("src/copals.ab") {
        const pwd_val = pwd()
        return replace_regex(pwd_val, "/[^/]+$", "", true)
    }
    return pwd()
}

const PROJECT_ROOT = project_root()
const project_vendor = "{PROJECT_ROOT}/copals/vendor"
const installed_vendor = "/usr/lib/copals/vendor"

// The installed vendor dir is authoritative when copals runs inside its own
// container: the host repo is bind-mounted at the same absolute path, so the
// project vendor dir also "exists" but its tools are only populated inside the
// image. Prefer the installed tree whenever it actually holds the binaries.
fun resolve_vendor_dir(): Text {
    if dir_exists(installed_vendor) and file_exists("{installed_vendor}/jsonnet") {
        return installed_vendor
    }
    if dir_exists(project_vendor) and file_exists("{project_vendor}/jsonnet") {
        return project_vendor
    }
    if dir_exists(installed_vendor) {
        return installed_vendor
    }
    if dir_exists(project_vendor) {
        return project_vendor
    }
    return ""
}

pub const VENDOR_DIR = resolve_vendor_dir()

// resolve_vendor_tool: resolve a vendored binary by name. Falls back to the
// bare name on PATH when no vendor dir is populated (doc 02, change 2: the
// former jq_resolve/j2_resolve/jsonnet_resolve/jsonschema_resolve/lua_resolve
// were 5 copies of this same 2-line rule).
fun resolve_vendor_tool(name: Text): Text {
    if VENDOR_DIR == "" {
        return name
    }
    return "{VENDOR_DIR}/{name}"
}

pub const JQ = resolve_vendor_tool("jq")
pub const J2 = resolve_vendor_tool("j2")
pub const JSONNET = resolve_vendor_tool("jsonnet")
pub const JSONSCHEMA = resolve_vendor_tool("jsonschema")
pub const LUA = resolve_vendor_tool("lua")
