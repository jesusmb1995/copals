import { file_read, file_write, temp_dir_create } from "std/fs"

const TMP_DIR = temp_dir_create("amber-XXXXXX", true, true) failed {
    "/tmp"
}

let token = 1

pub fun temp_file_create(suffix: Text = ""): Text? {
    token += 1 
    const tmp = "{TMP_DIR}/{token}{suffix}"
    touch(tmp)?
    return tmp
}

pub fun resolve_output_path(output_path: Text = ""): Text? {
    if output_path != "" {
        return output_path
    }
    return temp_file_create()?
}



