fun _can_apply(target_repo: Text, patch_file: Text): Bool {
    $ git -C {target_repo} apply --check {patch_file} $ failed {
        return false
    }
    return true
}

fun _can_apply_in_reverse(target_repo: Text, patch_file: Text): Bool {
    $ git -C {target_repo} apply --check --reverse {patch_file} $ failed {
        return false
    }
    return true
}

pub fun is_patch_already_applied(target_repo: Text, patch_file: Text): Bool {
    if {
        _can_apply_in_reverse(target_repo, patch_file) {
            return true
        } else {
            return false
        }
    }
}

pub fun git_apply_patch(target_repo: Text, patch_file: Text): Null? {
    $ git -C {target_repo} apply {patch_file} $ ?
}

pub fun git_init(repo: Text): Null? {
    $ git init {repo} $ ?
}

pub fun git_add(repo: Text, file: Text): Null? {
    $ git -C "{repo}" add "{file}" $ ?
}

pub fun git_commit(repo: Text, message: Text): Null? {
    $ git -C "{repo}" config user.email "test@example.com" $ failed {}
    $ git -C "{repo}" config user.name "Test User" $ failed {}
    $ git -C "{repo}" commit -m "{message}" $ ?
}

pub fun git_remote_add(repo: Text, name: Text, url: Text): Null? {
    $ git -C "{repo}" remote add {name} "{url}" $ ?
}

pub fun git_remote_get_url(repo: Text, name: Text): Text? {
    return $ git -C "{repo}" remote get-url {name} $ ?
}

pub fun git_remote_exists(repo: Text, name: Text): Bool {
    $ git -C "{repo}" remote get-url {name} >/dev/null 2>&1 $ failed {
        return false
    }
    return true
}

pub fun git_fetch(repo: Text, remote: Text, branch: Text): Null? {
    $ git -C "{repo}" fetch {remote} {branch} $ ?
}

// Like git_fetch but returns Bool instead of propagating failure (useful when
// the remote branch may not exist yet, e.g. the first publish).
pub fun git_try_fetch(repo: Text, remote: Text, branch: Text): Bool {
    $ git -C "{repo}" fetch {remote} {branch} $ failed {
        return false
    }
    return true
}

pub fun git_reset_hard(repo: Text, target_ref: Text): Null? {
    $ git -C "{repo}" reset --hard {target_ref} $ ?
}

// Repoint the current branch to target_ref WITHOUT touching the working tree
// or index. Used by publish so a freshly generated tree becomes a diff commit
// on top of the previous generation (hard reset would discard the new files).
pub fun git_reset_soft(repo: Text, target_ref: Text): Null? {
    $ git -C "{repo}" reset --soft {target_ref} $ ?
}

pub fun git_push(repo: Text, remote: Text, branch: Text): Null? {
    $ git -C "{repo}" push -u {remote} {branch} $ ?
}

pub fun git_try_checkout_new(repo: Text, branch: Text): Bool {
    $ git -C "{repo}" checkout -b {branch} $ failed {
        return false
    }
    return true
}

pub fun git_try_checkout(repo: Text, branch: Text): Bool {
    $ git -C "{repo}" checkout {branch} $ failed {
        return false
    }
    return true
}

pub fun git_current_branch(repo: Text): Text? {
    return $ git -C "{repo}" rev-parse --abbrev-ref HEAD $ ?
}

pub fun git_has_changes(repo: Text): Bool {
    const out = $ git -C "{repo}" status --porcelain $ failed {
        return false
    }
    return out != ""
}
