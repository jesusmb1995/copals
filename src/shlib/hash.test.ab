import { assert_eq } from "std/test"
import { hash_arr } from "hash.ab"

test "hash_arr: produces consistent hash" {
    const h1 = hash_arr(["a", "b", "c"])?
    const h2 = hash_arr(["a", "b", "c"])?
    assert_eq(h1, h2)
}

test "hash_arr: produces different hash for different inputs" {
    const h1 = hash_arr(["a", "b"])?
    const h2 = hash_arr(["c", "d"])?
    assert_eq(h1 != h2, true)
}