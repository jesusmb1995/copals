import { assert_eq } from "std/test"
import { symlink_create_dir } from "symlink.ab"
import { temp_dir_create, dir_exists } from "std/fs"

test "symlink_create_dir: creates a symlink to existing directory" {
    const origin = temp_dir_create("symlink-origin-XXXXXX")?
    const destination = temp_dir_create("symlink-dest-XXXXXX")?
    const link = "{destination}/link"
    
    symlink_create_dir(origin, link)?
    
    assert_eq(dir_exists(link), true)
}