import { file_exists } from "std/fs"
import { replace_regex } from "std/text"

fun _project_root(): Text {
    if file_exists("src/copals.ab") {
        const pwd_val = pwd()
        return replace_regex(pwd_val, "/[^/]+$", "", true)
    }
    return pwd()
}

pub const PROJECT_ROOT = _project_root()

// TODO must be handlded without repo root being outside copals...
const _REPO_GEN_DIR = "{PROJECT_ROOT}/copals"
pub const GEN_DIR="{_REPO_GEN_DIR}"
pub const GEN_SCRIPTS_DIR="{_REPO_GEN_DIR}/src/gen"
pub const SHLIB_DIR="{_REPO_GEN_DIR}/src/shlib"

// bashunit lives in the vendored tree. When copals runs inside its own
// container image the installed tree at /usr/lib/copals is authoritative
// (the bind-mounted host repo's vendor/ is not populated); prefer it.
const _INSTALLED_BASHUNIT = "/usr/lib/copals/vendor/lib/bashunit"
const _HOST_BASHUNIT = "{PROJECT_ROOT}/copals/vendor/lib/bashunit"
pub fun bashunit_path(): Text {
    if file_exists(_INSTALLED_BASHUNIT) {
        return _INSTALLED_BASHUNIT
    }
    return _HOST_BASHUNIT
}
pub const BASHUNIT = bashunit_path()

pub const RESOURCES_DIR="{_REPO_GEN_DIR}/res"
pub const SCHEMA_FILE="{RESOURCES_DIR}/config.schema.json"
pub const SKILLS_DIR="{RESOURCES_DIR}/skills"

// Jsonnet library search path: copals ships reusable `.libsonnet` helpers
// (e.g. `jsson.libsonnet`) under `copals/src/jsonnetlib`. Presets import them
// as `import 'jsonnetlib/...'`; `-J <this dir>` lets jsonnet resolve them.
pub const JSONNET_LIB_DIR="{_REPO_GEN_DIR}/src"

pub const DEST_ROOT="{PROJECT_ROOT}/jberlanga-devtools"
pub const DEST_DIR="{DEST_ROOT}/src"
pub const CHANGES_FILE="{DEST_DIR}/.generated_changes"
pub const INSTALLER_DIR="{DEST_ROOT}"
pub const HOOKS_DST="{INSTALLER_DIR}/repo-hooks"
