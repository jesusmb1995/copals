{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repositories"],
  "properties": {
    "Description": {
      "type": "string"
    },
    "base_image": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ai_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "browsers": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "system_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "target", "enabled", "clone"],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "clone": {
            "type": "boolean"
          },
          "inplace": {
            "type": "boolean"
          },
          "impl": {
            "type": "string"
          },
          "impl_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "disabled": {
      "type": "object",
      "description": "Repos excluded by a false condition in the preset. Keyed by repo id; values mirror the repository object shape. Not staged or built.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
