{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repositories"],
  "properties": {
    "Description": {
      "type": "string"
    },
    "base_image": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ai_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "browsers": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "system_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whitelist": {
          "type": "array",
          "description": "Glob patterns (shell `case` syntax) for files that are allowed to ship as opaque binaries / archives despite the --audit gate (e.g. ['*.ttf']). Empty by default: the gate blocks on any ELF/PE/shared-object or archive file.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "target", "enabled", "clone"],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "clone": {
            "type": "boolean"
          },
          "inplace": {
            "type": "boolean"
          },
          "impl": {
            "type": "string"
          },
          "impl_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "disabled": {
      "type": "object",
      "description": "Repos excluded by a false condition in the preset. Keyed by repo id; values mirror the repository object shape. Not staged or built.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "publish": {
      "type": "object",
      "description": "Optional: wrap the whole generated bundle in a git repo so each generation is a commit (changelist of generations). Push happens only when the generate command is invoked with --push; by default the commit stays local. Git identity/ssh auth are taken from the system (host) config.",
      "properties": {
        "remote": {
          "type": "string",
          "description": "Git remote URL to associate with the bundle repo (e.g. an https or ssh clone URL)."
        },
        "branch": {
          "type": "string",
          "description": "Branch to commit/push on. Defaults to 'main' when omitted.",
          "default": "main"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
